<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aiquestionhub.aiquestionhubapi.api.repository.PasswordResetTokenRepository">

    <resultMap id="PasswordResetTokenResultMap" type="com.aiquestionhub.aiquestionhubapi.api.model.PasswordResetToken">
        <id property="id" column="id"/>
        <result property="email" column="email"/>
        <result property="otp" column="otp"/>
        <result property="expiresAt" column="expires_at"/>
        <result property="used" column="used"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <select id="findLatestValidByEmail" resultMap="PasswordResetTokenResultMap">
        SELECT * FROM password_reset_tokens
        WHERE email = #{email}
          AND used = FALSE
          AND expires_at > NOW()
        ORDER BY created_at DESC
        LIMIT 1
    </select>

    <insert id="insert" parameterType="com.aiquestionhub.aiquestionhubapi.api.model.PasswordResetToken"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO password_reset_tokens (email, otp, expires_at, used, created_at)
        VALUES (#{email}, #{otp}, #{expiresAt}, #{used}, CURRENT_TIMESTAMP)
    </insert>

    <update id="markAllUsedByEmail">
        UPDATE password_reset_tokens SET used = TRUE WHERE email = #{email} AND used = FALSE
    </update>

    <update id="markUsedById">
        UPDATE password_reset_tokens SET used = TRUE WHERE id = #{id}
    </update>

</mapper>
