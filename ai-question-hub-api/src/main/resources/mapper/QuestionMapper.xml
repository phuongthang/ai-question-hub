<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aiquestionhub.aiquestionhubapi.api.repository.QuestionRepository">

    <resultMap id="QuestionResultMap" type="com.aiquestionhub.aiquestionhubapi.api.model.Question">
        <id property="id" column="id"/>
        <result property="code"         column="code"/>
        <result property="topicId"      column="topic_id"/>
        <result property="questionText" column="question_text"/>
        <result property="options"      column="options"/>
        <result property="answer"       column="answer"/>
        <result property="status"       column="status"/>
        <result property="aiModelId"    column="ai_model_id"/>
        <result property="prompt"       column="prompt"/>
        <result property="createdAt"    column="created_at"/>
        <result property="createdBy"    column="created_by"/>
        <result property="updatedAt"    column="updated_at"/>
        <result property="updatedBy"    column="updated_by"/>
        <result property="deletedAt"    column="deleted_at"/>
        <result property="deletedBy"    column="deleted_by"/>
    </resultMap>

    <select id="findByTopicId" parameterType="long" resultMap="QuestionResultMap">
        SELECT * FROM questions
        WHERE topic_id = #{topicId}
          AND deleted_at IS NULL
        ORDER BY created_at ASC
    </select>

</mapper>
